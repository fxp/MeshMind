{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meshmind-hub",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Hub"] }
  ]
}
